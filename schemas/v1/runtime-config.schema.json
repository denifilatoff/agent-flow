{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-flow.dev/schemas/v1/runtime-config.schema.json",
  "title": "Agent Flow runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "configuration", "provider", "execution", "polling", "runtime"],
  "properties": {
    "apiVersion": { "const": "agent-flow/v1alpha1" },
    "kind": { "const": "RuntimeConfig" },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "stack"],
      "properties": {
        "repository": { "$ref": "#/$defs/configurationRepository" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "stack": { "type": "string", "const": "config/stack.yaml" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "apiUrl", "repositories", "tokenFile"],
      "properties": {
        "type": { "enum": ["github", "gitlab"] },
        "apiUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?![^/?#]*@)[^?#]+$"
        },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+$" }
        },
        "tokenFile": { "$ref": "#/$defs/absolutePath" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agents", "harnesses"],
      "properties": {
        "agents": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/execution" }
        },
        "harnesses": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "codex": { "$ref": "#/$defs/harness" },
            "claude": { "$ref": "#/$defs/harness" }
          }
        }
      }
    },
    "polling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervalSeconds", "maxCallsPerMinute", "quotaReservePercent"],
      "properties": {
        "intervalSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "maxCallsPerMinute": { "type": "integer", "minimum": 1, "maximum": 20 },
        "quotaReservePercent": { "type": "integer", "minimum": 1, "maximum": 90 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concurrency", "dataDirectory", "http"],
      "properties": {
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 32 },
        "dataDirectory": { "$ref": "#/$defs/absolutePath" },
        "http": {
          "type": "object",
          "additionalProperties": false,
          "required": ["address", "port", "authFile"],
          "properties": {
            "address": { "type": "string", "minLength": 1, "maxLength": 255 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "authFile": { "$ref": "#/$defs/absolutePath" }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "absolutePath": { "type": "string", "pattern": "^/" },
    "configurationRepository": {
      "oneOf": [
        { "$ref": "#/$defs/absolutePath" },
        {
          "type": "string",
          "format": "uri",
          "pattern": "^(?:https://(?![^/?#]*@)[^?#]+|file:///[^?#]+)$"
        }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness", "model", "reasoning", "maxAttempts", "delaySeconds", "timeoutSeconds"],
      "properties": {
        "harness": { "enum": ["codex", "claude"] },
        "model": { "type": "string", "minLength": 1, "maxLength": 255 },
        "reasoning": { "enum": ["low", "medium", "high", "xhigh", "max"] },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "delaySeconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authFile"],
      "properties": { "authFile": { "$ref": "#/$defs/absolutePath" } }
    }
  }
}
