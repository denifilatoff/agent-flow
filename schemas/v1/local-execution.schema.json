{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-flow.dev/schemas/v1/local-execution.schema.json",
  "title": "Agent Flow local execution state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "controllerId",
    "observedAt",
    "owner",
    "disposition",
    "reason",
    "publicationKeys",
    "control"
  ],
  "properties": {
    "controllerId": { "$ref": "#/$defs/uuid" },
    "observedAt": { "type": "string", "format": "date-time" },
    "owner": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["controllerId", "publicationKey"],
          "properties": {
            "controllerId": { "$ref": "#/$defs/uuid" },
            "publicationKey": { "type": "string", "minLength": 1 }
          }
        },
        { "type": "null" }
      ]
    },
    "disposition": {
      "type": "string",
      "enum": ["ready", "waiting", "foreign", "ambiguous", "inactive"]
    },
    "reason": { "type": ["string", "null"] },
    "publicationKeys": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "control": {
      "oneOf": [
        { "$ref": "control-state.schema.json" },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
