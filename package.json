{
  "name": "agent-flow",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts test/config/*.test.ts test/flow/*.test.ts test/harness/*.test.ts test/provider/*.test.ts test/runtime/*.test.ts",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "xstate": "5.32.6",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "typescript": "7.0.2"
  }
}
